# Required for approval API write access
ADMIN_TOKEN=change-me-long-random-token

# Server
PORT=8787
HOST=0.0.0.0
TIMEZONE=Asia/Tokyo
BASE_URL=http://localhost:8787
DATA_FILE=server/data/posts.json

# Keep true until you confirm drafts, schedule, and X credentials.
DRY_RUN=true

# Optional: AI generation. Without this, deterministic fallback drafts are generated.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required only when DRY_RUN=false. OAuth2 user access token with tweet.write scope.
X_USER_ACCESS_TOKEN=
