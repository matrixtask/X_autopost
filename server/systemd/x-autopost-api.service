[Unit]
Description=X Autopost approval API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/X_autopost
EnvironmentFile=/opt/X_autopost/.env
ExecStart=/usr/bin/node /opt/X_autopost/server/src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
